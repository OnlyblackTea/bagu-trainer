# 学习者 SPA 的镜像：构建 frontend/，交给 nginx 托管，并把 REST 前缀反代到 platform。
#
# 为什么前端也要进 compose：后端是**纯 REST 控制面**，它不托管 SPA。少了这一层，`docker compose up`
# 之后浏览器没有入口（这正是之前"后端跑在 VM 上我怎么访问"那个问题的根源）。
FROM node:22-alpine AS build
WORKDIR /app
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci
COPY frontend/ ./
# 与 Vite 的 dev 代理同一份前缀表（frontend/vite.config.ts）——两边必须一致，
# 否则某个前缀会打到静态服务器上、拿回 index.html（真发生过）。
RUN npm run build

FROM nginx:1.27-alpine
COPY deploy/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html
EXPOSE 80
