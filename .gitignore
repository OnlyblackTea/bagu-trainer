# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
env/
.python-version

# ---- Tooling caches ----
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
coverage.xml
htmlcov/

# ---- Local exam / grading artifacts (D2/D3: never commit a learner's run) ----
# Runtime-injected canonical tests live in throwaway dirs and must not leak
# into a committable working tree (design §7.3).
.grading/
*.grading-report.json
scratch/
.exams/
!.gitkeep

# 默认持久化后端（sqlite）的数据库文件：那是**做题进度**，属于本机数据，不进仓库。
# 换地方用 --database-url / BAGU_DATABASE_URL（启动横幅会打印绝对路径）。
bagu.sqlite3
bagu.sqlite3-wal
bagu.sqlite3-shm
*.sqlite3

# ---- Secrets / local config (deployer brings their own LLM key, D3) ----
.env
.env.*
*.local
!.env.example

# ---- IDE / editor ----
.idea/
.vscode/
*.swp
*.swo

# ---- OS ----
.DS_Store
Thumbs.db
